# Spotify API credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_SEARCH_URL=https://api.spotify.com/v1/search

# MongoDB connection (local o Atlas M0: mongodb+srv://<user>:<pass>@<cluster>/...)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=spotify_electronica_colombia
# Alias aceptado por el dashboard (Streamlit Cloud usa este nombre por convencion)
# MONGODB_URI=
# MONGODB_DB=

# Project settings
SPOTIFY_MARKET=CO
START_YEAR=2018
END_YEAR=2025
DEFAULT_GENRE=electronic
# 0 = sin filtro. Subir a 20-30 para filtrar por popularidad.
MIN_POPULARITY=0

# Optional runtime settings
LOG_LEVEL=INFO
REQUEST_DELAY_SECONDS=1

